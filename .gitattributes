# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf

# Shell scripts are executed directly (./script.sh) on Linux/WSL/macOS via
# their shebang line. A CRLF checkout on Windows leaves a trailing \r glued
# to "bash" in "#!/usr/bin/env bash", so the kernel tries to exec a binary
# literally named "bash\r" and fails with "No such file or directory". Force
# LF regardless of core.autocrlf, the same way *.bat is forced to CRLF above.
*.sh text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary
